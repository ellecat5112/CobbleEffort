    "main": ["io.github.cobbleeffort.fusion.fabric.FusionFabric"]
  },
  "mixins": ["cobbleeffort_fusion.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "architectury": ">=13.0.8",
    "cobblemon": ">=1.8.4"
  },
  "recommends": {
